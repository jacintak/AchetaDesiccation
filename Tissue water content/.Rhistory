platemap_file <-  "DryMassTest1.xlsx" # e.g. "plate.xlsx"
spec_file <- "20260306_VanillinTest1.xlsx" # e.g. "BCA assay.xlsx"
metadata_file <- platemap_file # e.g. "metadata.xlsx"
# L8 in excel is H12 on the plate and well 96
plate_map <- read_excel(paste0(wd, platemap_file),
col_names = as.character(1:12),
sheet = "platemap",
range = "A1:L8")
platemap_file <-  "DryMassTest.xlsx" # e.g. "plate.xlsx"
# L8 in excel is H12 on the plate and well 96
plate_map <- read_excel(paste0(wd, platemap_file),
col_names = as.character(1:12),
sheet = "platemap",
range = "A1:L8")
plate <- data.frame(grid = paste0(rep(LETTERS[1:8], 12), sort(rep(1:12, 8))),
well = 1:96,
content = unlist(plate_map))
# What are your standard concentrations including blank? Character vector
# standard_names <- c("15", "8", "2.5", "2", "1.5", "1", "0.5", "0.25", "0.125", "0")
standard_names <- plate$content[17:25]
# Check the map of sample wells are what you expect
plate
plate_map
spec <- read_excel(paste0(wd, spec_file), range = "B2:M9", col_names = paste(1:12))
# Add the absorbance values to the corresponding wells
plate$absorbance <- as.numeric(unlist(spec))
# Remove empty wells
plate <- plate[!is.na(plate$content),]
# Check the right absorbance values are associated with the right wells
plate
standard_names <- c("15", "8", "2.5", "2", "1.5", "1", "0.5", "0.25", "0.125", "0")
spec <- read_excel(paste0(wd, spec_file), range = "B2:M9", col_names = paste(1:12))
# Add the absorbance values to the corresponding wells
plate$absorbance <- as.numeric(unlist(spec))
# Remove empty wells
plate <- plate[!is.na(plate$content),]
# Check the right absorbance values are associated with the right wells
plate
# Subtract average of the blank from samples
plate$corrected_abs <- plate$absorbance - mean(plate[plate$content == "0",]$absorbance)
# Check coefficient of variation for all samples
standards_cv <- aggregate(absorbance ~ content,
plate,
FUN = \(x) 100 * (sd(x, na.rm = TRUE)/mean(x, na.rm = TRUE)))
# Get average for samples
standards_abs <- aggregate(corrected_abs ~ content, plate, mean, na.rm = TRUE)
# Fix the values of the blank to 0
standards_abs[standards_abs$content == "0",]$corrected_abs <- 0
standards_abs # Check
# Get only the standard curve data
standard_curve_data <- subset(standards_abs, content %in% standard_names)
# Fit the fixed intercept linear model
standard_curve_model <- lm(corrected_abs ~ as.numeric(content), standard_curve_data)
# Check the R2 value and model parameters
summary(standard_curve_model)
r2 <- round(summary(standard_curve_model)$r.squared, 3) * 100 # R2
intercept <- standard_curve_model$coefficients[1] # intercept
eqn <- standard_curve_model$coefficients[2] # slope
plot(corrected_abs ~ content, standard_curve_data,
xlab = "Concentration",
ylab = "Absorbance")
abline(standard_curve_model)
title(paste0("R2 = ", r2, "%"))
text(y = max(standard_curve_data$corrected_abs),
x = 0,
paste0("Absorbance = ", round(eqn, 2), " x Concentration"),
adj = c(0, 1))
sample_data <- subset(plate, !content %in% c(standard_names))
# Calculate concentration of the well as mg/mL
sample_data$well_conc <- (sample_data$corrected_abs - intercept)/ eqn
sample_data <- aggregate(well_conc ~ content, sample_data,
function(x) c(mean = mean(x), se = sd(x)/sqrt(length(x)))) |> lapply(X = _, FUN = unlist) |> as.data.frame()
names(sample_data) <- c("content", "well_conc", "well_se")
sample_data
bp <- barplot(well_conc ~ content, sample_data,
xlab = "Sample",
ylab = "Concentration",
ylim = c(0, max(sample_data$well_conc) * 1.2))
arrows(bp,
sample_data$well_conc + sample_data$well_se,
bp, sample_data$well_conc - sample_data$well_se,
angle=90, code=3, length = 0.15)
unspiked <- sample_data[sample_data$content =="106B",]$well_conc
spiked <- sample_data[sample_data$content =="SpikeB",]$well_conc
added <- (1*75)/150 #M1V1 = M2V2
spike_recovery <-  ((spiked - unspiked) / added) * 100
